# Copy this file to backend/config/daraja.env and fill it locally.
MPESA_ENVIRONMENT=sandbox
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=
MPESA_PASSKEY=

# After Vercel deployment, replace YOUR-REAL-VERCEL-DOMAIN.
MPESA_CALLBACK_URL=https://YOUR-REAL-VERCEL-DOMAIN/api/v1/payments/mpesa/callback

MPESA_ACCOUNT_REFERENCE=KaziLink
MPESA_TRANSACTION_DESCRIPTION=KaziLink Payment
